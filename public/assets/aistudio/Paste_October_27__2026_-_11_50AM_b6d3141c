        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-in fade-in duration-200">
          <div className="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl flex flex-col items-center text-center animate-in zoom-in-95 duration-300">
            {isEvaluating ? (
              <BrainCircuit className="text-teal-500 animate-pulse mb-4" size={40} />
            ) : (
              <Save className="text-teal-500 mb-4" size={40} />
            )}
            <h3 className="font-bold text-base text-slate-800 mb-2">{isEvaluating ? t('loading') : '系統提示'}</h3>
            <p className="text-sm text-slate-500 font-medium">{modalMsg}</p>
          </div>
        </div>
      )}

      {/* Fullscreen Loading Overlay for initial Gemini call */}
      {isEvaluating && !modalMsg && (
        <div className="fixed inset-0 bg-slate-900/70 backdrop-blur-md z-50 flex flex-col items-center justify-center text-white">
           <BrainCircuit className="text-teal-400 animate-bounce mb-6" size={56} />
           <h3 className="text-lg font-bold mb-2 tracking-widest">{t('aiAnalysis')}</h3>
           <p className="text-teal-100/80 max-w-xs text-center text-xs font-medium">{t('aiThinking')}</p>
        </div>
      )}
    </div>
  );
}