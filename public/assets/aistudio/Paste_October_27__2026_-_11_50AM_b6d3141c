export default function App() {
  const [lang, setLang] = useState('zh');
  const t = (key, nestedKey = null) => {
    if (nestedKey) return translations[lang][key]?.[nestedKey] || nestedKey;
    return translations[lang][key] || key;
  };

  const [user, setUser] = useState(null);
  const [currentView, setCurrentView] = useState('dashboard'); // 'dashboard', 'wizard', 'decision'
  const [events, setEvents] = useState([]);
  const [loadingFirebase, setLoadingFirebase] = useState(true);
  
  // State for Wizard & Evaluation
  const [formData, setFormData] = useState({
    name: '', pax: '', crossCounty: 'no', vulnerable: 'no', 
    transport: 'rail', necessity: 'medium', alternatives: 'online', deadline: '', riskLevel: 'medium'
  });
  const [aiEvaluation, setAiEvaluation] = useState(null);
  const [isEvaluating, setIsEvaluating] = useState(false);
  const [modalMsg, setModalMsg] = useState('');
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);

  // --- Live Time & Deadline Calculations (Synced with System Clock) ---
  const [now, setNow] = useState(new Date());

  useEffect(() => {
    // Update the clock every minute to keep the UI perfectly synced with real time
    const timer = setInterval(() => setNow(new Date()), 60000);
    return () => clearInterval(timer);
  }, []);

  // Set the nominal deadline to 18:00 (6:00 PM) of the current day
  const targetDeadline = new Date(now);
  targetDeadline.setHours(18, 0, 0, 0);

  let diffHours = Math.ceil((targetDeadline - now) / (1000 * 60 * 60));
  let isPastDeadline = diffHours <= 0;
  
  // Calculate dynamic T-minus text (e.g., T-7h)
  let displayTText = isPastDeadline ? 'T-0h' : `T-${diffHours}h`;
  
  // Calculate dynamic progress bar percentage (assuming a 24-hour cycle)
  let progressPercent = isPastDeadline ? 100 : Math.max(0, 100 - ((diffHours / 24) * 100));
  
  const formattedTodayShort = `${now.getMonth() + 1}/${now.getDate()}`;
  const formattedTodayFull = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

  // --- Live Government Data State ---
  const [liveGovData, setLiveGovData] = useState(null);
  const [isFetchingGov, setIsFetchingGov] = useState(false);
  const [lastSyncTime, setLastSyncTime] = useState(null);

  // --- Firebase Auth & Data Fetching ---
  useEffect(() => {
    if (!auth) {
      setLoadingFirebase(false);
      return;
    }

    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) {
        console.error('Firebase Auth Error:', error);
      }
    };

    initAuth();

    const unsubscribeAuth = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
    });

    return () => unsubscribeAuth();
  }, []);

  useEffect(() => {
    if (!user || !db) return;

    const collectionRef = collection(db, 'artifacts', appId, 'public', 'data', 'decision_logs');
    
    const unsubscribe = onSnapshot(collectionRef, (snapshot) => {
      const fetchedEvents = [];
      snapshot.forEach((doc) => {
        fetchedEvents.push({ id: doc.id, ...doc.data() });
      });
      fetchedEvents.sort((a, b) => new Date(a.deadline) - new Date(b.deadline));
      setEvents(fetchedEvents);
      setLoadingFirebase(false);
    }, (error) => {
      console.error('Firestore subscription error:', error);
      setLoadingFirebase(false);
    });

    return () => unsubscribe();
  }, [user]);

  // --- Fetch Live Gov Intelligence ---
  const fetchLiveGovernmentData = async () => {
    setIsFetchingGov(true);
    try {
      const apiKey = ""; 
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
      
      const todayStr = new Date().toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
      
      const prompt = `
        You are a disaster intelligence assistant for Taiwan. Search the web (Google Search) for the absolute latest breaking news TODAY (${todayStr}) regarding typhoons, heavy rain, earthquakes, or major transport disruptions (Taiwan Railway, highways) in Taiwan.
        Consult both official government channels (中央氣象署 CWA) and reliable outsourced news media (e.g., 中央社 CNA, or major news outlets) to get the fastest real-time updates.
        Summarize the 2 most critical pieces of real-time intelligence for a disaster response team.
        Respond STRICTLY in JSON format matching this schema:
        {
          "updates": [
            { 
              "icon": "Weather" or "Transport", 
              "title": "Short Headline (include source, e.g. 中央社 or 氣象署)", 
              "desc": "One sentence detail of the current real-time status today." 
            }
          ]
        }
      `;

      const payload = {
        contents: [{ parts: [{ text: prompt }] }],
        tools: [{ "google_search": {} }], // Enables real-time Google Search grounding
        generationConfig: { responseMimeType: "application/json" }
      };

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();
      if (result.candidates && result.candidates.length > 0) {
        const jsonStr = result.candidates[0].content.parts[0].text;
        const parsedData = JSON.parse(jsonStr);
        setLiveGovData(parsedData.updates);
        setLastSyncTime(new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}));
      }
    } catch (error) {
      console.error("Gov Data Fetch Error:", error);
    } finally {
      setIsFetchingGov(false);
    }
  };

  // --- AI API Integration ---
  const callGeminiAPI = async (dataToEvaluate) => {
    setIsEvaluating(true);
    try {
      const prompt = `
        You are a highly professional disaster decision-making expert for the Tzu Chi Foundation.
        Evaluate the following event based on the RENAD framework (Risk, Exposure, Necessity, Alternatives, Deadline).
        Event Details:
        - Name: ${dataToEvaluate.name}
        - Risk Level: ${dataToEvaluate.riskLevel}
        - Participants: ${dataToEvaluate.pax}
        - Cross-County Travel: ${dataToEvaluate.crossCounty}
        - Includes Vulnerable Groups: ${dataToEvaluate.vulnerable}
        - Transportation: ${dataToEvaluate.transport}
        - Necessity: ${dataToEvaluate.necessity}
        - Selected Alternative: ${dataToEvaluate.alternatives}
        - Deadline for decision: ${dataToEvaluate.deadline}

        Based on safety-first principles and service continuity, recommend one of the following decisions:
        "GO", "CONDITIONAL_GO", "ADAPTIVE_GO", or "NO_GO".
        
        Provide the response strictly as a JSON object with this schema:
        {
          "recommendation": "GO | CONDITIONAL_GO | ADAPTIVE_GO | NO_GO",
          "reasoning": "Detailed explanation of why this decision is recommended based on the exposure and risks.",
          "criticalFactors": ["Factor 1", "Factor 2", "Factor 3"]
        }
      `;

      const apiKey = ""; 
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
      
      const payload = {
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: { responseMimeType: "application/json" }
      };

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();
      if (result.candidates && result.candidates.length > 0) {
        const jsonStr = result.candidates[0].content.parts[0].text;
        const evaluation = JSON.parse(jsonStr);
        setAiEvaluation(evaluation);
        setCurrentView('decision');
      }
    } catch (error) {
      console.error("Gemini API Error:", error);
      setModalMsg("Error evaluating with AI. Please try again.");
    } finally {
      setIsEvaluating(false);
    }
  };

  const handleWizardSubmit = (e) => {
    e.preventDefault();
    if (!formData.name || !formData.deadline) {
      setModalMsg('請填寫必填欄位 (Please fill required fields)');
      return;
    }
    callGeminiAPI(formData);
  };

  const handleSaveDecision = async (finalDecision) => {
    if (!user || !db) {
      setModalMsg("Firebase not initialized. Cannot save.");
      return;
    }

    try {
      const collectionRef = collection(db, 'artifacts', appId, 'public', 'data', 'decision_logs');
      await addDoc(collectionRef, {
        ...formData,
        aiRecommendation: aiEvaluation.recommendation,
        aiReasoning: aiEvaluation.reasoning,
        finalDecision: finalDecision,
        timestamp: serverTimestamp(),
        evaluatorId: user.uid
      });
      
      setModalMsg(t('saveSuccess'));
      setTimeout(() => {
        setModalMsg('');
        setAiEvaluation(null);
        setFormData({ name: '', pax: '', crossCounty: 'no', vulnerable: 'no', transport: 'rail', necessity: 'medium', alternatives: 'online', deadline: '', riskLevel: 'medium' });
        setCurrentView('dashboard');
      }, 2000);
    } catch (error) {
      console.error("Save error:", error);
      setModalMsg("Failed to save to cloud.");
    }
  };

  const handleDeleteEvent = async (id) => {
    if (!user || !db) return;
    try {
      const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'decision_logs', id);
      await deleteDoc(docRef);
    } catch (error) {
      console.error("Delete error:", error);
    }
  };

  // --- Utility Components ---
  const NavItem = ({ viewId, icon: Icon, title, subtitle }) => {
    const isActive = currentView === viewId;
    return (
      <button 
        onClick={() => { setCurrentView(viewId); setIsSidebarOpen(false); }}
        className={`w-full flex items-center px-4 py-3 text-left transition-colors ${
          isActive ? 'bg-teal-50 text-teal-600 border-r-2 border-teal-500' : 'text-slate-500 hover:bg-slate-50 hover:text-slate-800'
        }`}
      >
        <Icon size={20} className={`mr-4 ${isActive ? 'text-teal-600' : 'text-slate-400'}`} />
        <div className="flex flex-col">
          <span className="font-semibold text-sm leading-tight">{title}</span>
          <span className={`text-[10px] font-medium ${isActive ? 'text-teal-500' : 'text-slate-400'}`}>{subtitle}</span>
        </div>
      </button>
    );
  };

  const DecisionBadge = ({ decision }) => {
    const styles = {
      'GO': 'bg-green-100 text-green-700 border-green-200',
      'CONDITIONAL_GO': 'bg-yellow-100 text-yellow-700 border-yellow-200',
      'ADAPTIVE_GO': 'bg-orange-100 text-orange-700 border-orange-200',
      'NO_GO': 'bg-red-100 text-red-700 border-red-200'
    };
    const defaultStyle = 'bg-slate-100 text-slate-600 border-slate-200';
    const key = decision ? decision.replace('-', '_') : '';
    
    return (
      <span className={`px-2.5 py-1 rounded-md text-[11px] font-bold border shadow-sm ${styles[key] || defaultStyle}`}>
        {t(decision) || decision}
      </span>
    );
  };

  return (
    <div className="flex h-screen overflow-hidden bg-[#f4f7f9] font-sans text-slate-800 antialiased">
      
      {/* Mobile Sidebar Overlay */}
      {isSidebarOpen && (
        <div className="fixed inset-0 bg-slate-900/50 z-40 md:hidden" onClick={() => setIsSidebarOpen(false)} />
      )}

      {/* Sidebar */}
      <aside className={`fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200 transform transition-transform duration-300 md:relative md:translate-x-0 flex flex-col ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}`}>
        {/* Logo */}
        <div className="h-20 flex items-center px-6 border-b border-slate-100">
          <div className="w-10 h-10 rounded-full bg-teal-500 text-white flex items-center justify-center mr-3 shadow-md">
            <ShieldAlert size={20} />
          </div>
          <div>
            <h1 className="font-bold text-slate-800 text-sm leading-tight tracking-wide">活動決策助手</h1>
            <p className="text-[10px] text-slate-500 font-medium uppercase tracking-wider">Decision Helper</p>
          </div>
        </div>
        
        {/* Nav Links */}
        <nav className="flex-1 py-6 space-y-1">
          <NavItem viewId="dashboard" icon={PieChart} title="事件總覽" subtitle="Dashboard" />
          <NavItem viewId="wizard" icon={ClipboardList} title="活動評估" subtitle="Event Wizard" />
          <NavItem viewId="decision" icon={Scale} title="主管決策" subtitle="Supervisor Decisions" />
        </nav>

        {/* Footer Settings/Lang Toggle */}
        <div className="p-4 border-t border-slate-100">
           <button 
              onClick={() => setLang(lang === 'zh' ? 'en' : 'zh')}
              className="w-full flex items-center justify-center space-x-2 px-3 py-2 rounded-lg bg-slate-50 text-slate-500 hover:bg-slate-100 transition text-xs font-medium"
            >
              <Globe size={14} />
              <span>{lang === 'zh' ? 'Switch to English' : '切換至中文'}</span>
            </button>
        </div>
      </aside>

      {/* Main Content Area */}
      <div className="flex-1 flex flex-col h-full overflow-hidden relative">
        
        {/* Top Header */}
        <header className="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 z-10 flex-shrink-0">
          <div className="flex items-center">
            <button className="md:hidden text-slate-500 hover:text-slate-800 mr-4" onClick={() => setIsSidebarOpen(true)}>
              <Menu size={24} />
            </button>
            <h2 className="text-sm font-bold text-slate-800 flex items-center">
              薔琵颱風專案 <span className="text-xs font-medium text-slate-400 ml-3 hidden sm:inline-block">Typhoon Champi - {formattedTodayShort}</span>
            </h2>
          </div>
          
          <div className="flex items-center space-x-6">
            <div className="text-right hidden sm:block">
              <p className="text-xs font-bold text-slate-700">{displayTText} 查核點</p>
              <p className="text-[10px] text-slate-400">{formattedTodayFull} 18:00</p>
            </div>
            <div className="h-9 w-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center border border-slate-200 shadow-sm">
              <User size={16} />
            </div>
          </div>
        </header>

        {/* Scrollable Content */}
        <main className="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
          
          {/* VIEW: DASHBOARD */}
          {currentView === 'dashboard' && (
            <div className="max-w-6xl mx-auto space-y-8 animate-in fade-in duration-500">
              
              {/* Dashboard Titles */}
              <div>
                <h2 className="text-2xl font-bold text-slate-800 flex items-baseline">
                  事件總覽 <span className="text-xl font-normal text-slate-400 ml-3">Dashboard</span>
                </h2>
                <p className="text-sm text-slate-500 mt-2 font-medium">整合多方資訊，收斂結構化事實 (Converging structured facts)</p>
              </div>

              {/* Three Core Widgets (Styled to match screenshot exactly) */}
              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                {/* Widget 1: What We Know (LIVE GOV INTEGRATION) */}
                <div className="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col h-full hover:shadow-md transition-shadow relative">
                  <div className="flex items-center justify-between mb-6">
                    <div className="flex items-center">
                      <div className="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4">
                        <Eye size={20} />
                      </div>
                      <div>
                        <h3 className="font-bold text-slate-800 text-sm">情資快照板</h3>
                        <p className="text-[9px] text-slate-400 uppercase tracking-widest mt-0.5">What We Know</p>
                      </div>
                    </div>
                    <button 
                      onClick={fetchLiveGovernmentData}
                      disabled={isFetchingGov}
                      className="p-2 rounded-full bg-slate-50 text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-colors"
                      title="Sync with Gov Channels"
                    >
                      <RefreshCcw size={14} className={isFetchingGov ? "animate-spin text-blue-500" : ""} />
                    </button>
                  </div>
                  
                  <ul className="space-y-4 flex-1">
                    {isFetchingGov ? (
                      <li className="flex flex-col items-center justify-center h-full text-slate-400 space-y-2 py-4">
                        <Loader2 className="animate-spin" size={20} />
                        <span className="text-xs font-medium">即時檢索政府發布中...</span>
                      </li>
                    ) : liveGovData ? (
                      liveGovData.map((update, idx) => (
                        <li key={idx} className="flex items-start">
                          <div className={`mt-1 w-4 h-4 flex items-center justify-center mr-3 ${update.icon === 'Transport' ? 'text-red-500' : 'text-blue-500'}`}>
                            {update.icon === 'Transport' ? <TriangleAlert size={14} /> : <CloudRainWind size={14} />}
                          </div>
                          <div>
                            <span className="font-bold text-slate-700 text-sm">{update.title}</span>
                            <p className="text-xs text-slate-500 mt-1">{update.desc}</p>
                          </div>
                        </li>
                      ))
                    ) : (
                      <>
                        <li className="flex items-start">
                          <div className="mt-1 w-4 h-4 flex items-center justify-center mr-3 text-red-500"><TriangleAlert size={14} /></div>
                          <div>
                            <span className="font-bold text-slate-700 text-sm">台鐵公告</span>
                            <p className="text-xs text-slate-500 mt-1">{formattedTodayShort} 上午北迴線部分停駛</p>
                          </div>
                        </li>
                        <li className="flex items-start">
                          <div className="mt-1 w-4 h-4 flex items-center justify-center mr-3 text-teal-500"><Users size={14} /></div>
                          <div>
                            <span className="font-bold text-slate-700 text-sm">參與規模</span>
                            <p className="text-xs text-slate-500 mt-1">總計約 2,837 人受影響</p>
                          </div>
                        </li>
                      </>
                    )}
                  </ul>
